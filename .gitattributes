# Auto-detect text files, force LF
* text=auto eol=lf

# JS sources
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Config / dotfiles
*.sh text eol=lf
*.gitignore text eol=lf
.editorconfig text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf

# Binary files — never touch
*.png binary
*.jpg binary
*.svg binary
*.ico binary
*.woff binary
*.ttf binary
